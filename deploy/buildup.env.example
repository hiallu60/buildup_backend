SPRING_PROFILES_ACTIVE=prod
BUILDUP_SERVER_PORT=8080

BUILDUP_DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/buildup?sslMode=REQUIRED&serverTimezone=Asia/Seoul
BUILDUP_DB_USERNAME=buildup_app
BUILDUP_DB_PASSWORD=CHANGE_ME
BUILDUP_DB_POOL_SIZE=5
BUILDUP_DB_MIN_IDLE=1

BUILDUP_JWT_SECRET=CHANGE_ME_TO_BASE64_ENCODED_32_BYTE_OR_LONGER_SECRET

BUILDUP_CORS_ALLOWED_ORIGINS=http://YOUR_FRONTEND_ORIGIN

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=YOUR_PRIVATE_S3_BUCKET
AWS_EC2_METADATA_V1_DISABLED=true
BUILDUP_S3_CONNECTION_CHECK_ENABLED=false
BUILDUP_S3_MAX_PHOTO_SIZE_BYTES=10485760
BUILDUP_S3_MAX_FILE_SIZE_BYTES=20971520
BUILDUP_S3_MAX_FILE_SIZE=20MB
BUILDUP_S3_MAX_REQUEST_SIZE=21MB
