[Unit]
Description=BuildUp Spring Boot API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=buildup
Group=buildup
WorkingDirectory=/opt/buildup
EnvironmentFile=/etc/buildup/buildup.env
ExecStart=/usr/bin/java -jar /opt/buildup/buildup.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
